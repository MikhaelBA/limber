{
  "name": "@limber/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight animation player for exported Limber documents, built on @limber/core.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
